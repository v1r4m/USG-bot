# 하양이 환경 변수 예시 파일.
# 이 파일을 복사해 `.env` 로 저장한 뒤 값을 채워 주세요.
#   cp .env.example .env

# [필수] 디스코드 봇 토큰.
# https://discord.com/developers/applications 에서 애플리케이션을 만들고
# Bot 탭에서 토큰을 발급받아 붙여넣으세요.
DISCORD_TOKEN=

# [선택] 개발용 길드(서버) ID.
# 값을 지정하면 슬래시 커맨드가 해당 서버에 "즉시" 동기화됩니다(개발 시 권장).
# 비워 두면 전역 동기화되며 전 서버에 반영되기까지 최대 1시간 걸립니다.
DISCORD_GUILD_ID=

# [선택] 로그 레벨: DEBUG / INFO / WARNING / ERROR (기본값: INFO)
LOG_LEVEL=INFO

# [선택] CTFd 연동 정보(토큰 포함)를 저장할 디렉터리 (기본값: data)
# Docker 에서는 docker-compose.yml 의 볼륨 경로(/app/data)를 그대로 쓰면 됩니다.
DATA_DIR=data

# [선택] CTFd 에서 새 문제·풀이를 확인하는 주기(분) (기본값: 5)
CTFD_POLL_MINUTES=5
